# Vista Social Network Environment Configuration Template
# Duplicate this file to '.env' and fill in your actual credentials.

# API Backend Configuration
BACKEND_URL=http://10.0.2.2:8080

# Arvan Cloud S3 Storage Configuration
ARVAN_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ARVAN_ACCESS_KEY=your-arvan-access-key-here
ARVAN_SECRET_KEY=your-arvan-secret-key-here
ARVAN_BUCKET=your-arvan-bucket-name
ARVAN_REGION=ir-thr-at1
ARVAN_USE_PATH_STYLE=true
ARVAN_PRESIGN_EXPIRY=15m
ARVAN_PUBLIC_BASE_URL=https://your-cdn-or-s3-public-domain/your-bucket
